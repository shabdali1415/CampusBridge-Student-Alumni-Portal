{
  "name": "student-event-registration-alumni-portal",
  "version": "1.0.0",
  "description": "Student Event Registration and Alumni Portal with concurrency tests, CI, Docker, OpenAPI and React/TypeScript starter",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:setup": "node db/setup.js",
    "db:reset": "node db/setup.js --reset",
    "postinstall": "node scripts/copy-vendor.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:integration": "jest --runInBand tests/registration-concurrency.test.js",
    "start:prod": "node server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "nodemailer": "^6.9.16",
    "node-cron": "^3.0.3",
    "jsqr": "^1.4.0",
    "chart.js": "^4.4.7",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
