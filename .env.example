NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=student_portal
DB_USER=student_portal_app
DB_PASSWORD=change_me
DB_CONNECTION_LIMIT=10

# Use long random strings (>= 16 chars), e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string

# Optional: leave blank in development - verification/reset links print to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Campus Portal <no-reply@your-domain.example>

# Docker Compose only
MYSQL_ROOT_PASSWORD=change_this_root_password
